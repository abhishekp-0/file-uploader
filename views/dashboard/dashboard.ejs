<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
  </head>
  <body>
    <header>
      <h1>Dashboard</h1>
      <p>Welcome, <strong><%= user.username %></strong>!</p>
      <form method="post" action="/logout">
        <button>logout</button>
      </form>
    </header>
    <nav aria-label="Breadcrumb">
      <ol>
        <li><a href="/dashboard">root</a></li>
        <% for( let i = 0; i < breadcrumbs.length; i++ ) { %>
          <li><a href="/entities/<%- breadcrumbs[i].id%>"><%= breadcrumbs[i].name %></a></li>
        <% } %>
      </ol>
    </nav>
    <br>
    <% if (breadcrumbs.length>0) { %>
      <h2><%= breadcrumbs[breadcrumbs.length-1].name %></h2>
    <% } else { %>
     <h2>Root</h2>
    <% } %>
    <div>
      <ul>
        <% const returnTo = currentFolderId ? (`/entities/${currentFolderId}`) : '/dashboard'; %>

        <% for (let i = 0; i < entities.length; i++) { %>
          <li>
            <a href="/entities/<%= entities[i].id %>">
              <%- entities[i].name %>(<%- entities[i].type %>)
            </a>

            <button type="button" data-action="rename-toggle" data-entity-id="<%= entities[i].id %>">
              Rename
            </button>

            <form
              method="POST"
              action="/entities/<%= entities[i].id %>?_method=PUT"
              data-rename-form="<%= entities[i].id %>"
              hidden
            >
              <input type="text" name="name" value="<%= entities[i].name %>" required />
              <button type="submit">Save</button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  </br>
  <h2>Add a Folder</h2>
    <form method="POST" action="/entities/folder?parent=<%= currentFolderId || '' %>">
      <div>
        <label for="name">Folder Name:</label>
        <input type="text" id="name" name="name" required />
      </div>
      
      <button type="submit">Add Folder</button>
    </form>
  </body>

  <h2>Upload a File</h2>
    <form method="POST" action="/upload/file?parentId=<%= currentFolderId || '' %>" enctype="multipart/form-data">
      <div>
        <input type="file" name="file" required />
      </div>
      
      <button type="submit">Upload File</button>
    </form>
  </body>
  <script src="/dashboard.js" defer></script>
</html>
