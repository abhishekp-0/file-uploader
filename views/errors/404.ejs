<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Not Found</title>
    <link rel="stylesheet" href="/style.css" />
</head>
<body>
    <% if (user) { %>
      <header>
        <h1>Dashboard</h1>
        <p>Welcome, <strong><%= user.username %></strong>!</p>
        <form method="post" action="/logout">
          <button>logout</button>
        </form>
      </header>
    <% } %>
    
    <div class="error-container">
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Not Found</h2>
        <p class="error-message">
            <%= message || 'The item you are looking for does not exist or you do not have access to it.' %>
        </p>
        
        <p class="error-explanation">
            This item may have been deleted, moved, or you may not have permission to access it.
        </p>
        
        <div class="error-actions">
            <% if (user) { %>
                <a href="/dashboard" class="primary-btn">Go to Dashboard</a>
            <% } else { %>
                <a href="/" class="primary-btn">Go to Home</a>
                <a href="/login" class="secondary-btn">Log In</a>
            <% } %>
        </div>
    </div>
</body>
</html>